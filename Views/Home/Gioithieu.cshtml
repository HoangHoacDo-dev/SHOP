@model List<SHOP.Models.Sanpham>
@{
    ViewData["Title"] = "Gioithieu";
}
<div class="text-center">
    <h1 class="display-4"> CHÀO MỪNG CÁC BẠN ĐÃ ĐẾN VỚI SIUU</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Tên</th>
                <th>Mô tả</th>
                <th>Giá</th>
                <th>Hình ảnh</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Ten</td>
                    <td>@item.Mota</td>
                    <td>@item.Gia.ToString("C")</td>
                    <td><img src="~/images/@item.Hinhanh" alt="@item.Ten" class="img-thumbnail" style="max-width: 100px;" /></td>
                </tr>
            }
        </tbody>
    </table>
</div>