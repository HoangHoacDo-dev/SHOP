@model List<SHOP.Models.Tennhacungcap>
@{
    ViewData["Title"] = "Nhacungcap";
}
<div class="text-center">
    <h1 class="display-4"> DANH SACH NHA CUNG CAP </h1>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Tên</th>
                <th>Địa chỉ</th>
                <th>Số điện thoại</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Ten</td>
                    <td>@item.Diachi</td>
                    <td>@item.Sdt</td>
                </tr>
            }
        </tbody>
    </table>
</div>